# Store as /opt/hrms/.env.backend and chmod 600.
APP_NAME=Newtuple HRMS
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
SESSION_COOKIE_NAME=hrms_session

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hrms.example.com/api/v1/auth/google/callback
ALLOWED_EMAIL_DOMAIN=newtuple.com

FRONTEND_URL=https://hrms.example.com
CORS_ORIGINS=["https://hrms.example.com"]

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Newtuple HRMS <no-reply@newtuple.com>"
OUTBOX_FLUSH_INTERVAL_SECONDS=20

DOCUMENT_STORAGE_DIR=storage/documents
FLOWTUPLE_BASE_URL=https://flowtuple.newtuple.internal
FLOWTUPLE_ENABLED=false

# Creates the first administrator on an empty production database.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@newtuple.com
BOOTSTRAP_SUPERADMIN_FIRST_NAME=Initial
BOOTSTRAP_SUPERADMIN_LAST_NAME=Administrator
BOOTSTRAP_SUPERADMIN_EMPLOYEE_CODE=NT0001
