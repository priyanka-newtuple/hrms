ENV=development
APP_NAME=Newtuple HRMS

DATABASE_URL=postgresql+asyncpg://hrms:hrms@postgres:5432/hrms

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
SESSION_COOKIE_NAME=hrms_session

# Create an OAuth 2.0 Client ID in Google Cloud Console (Web application type),
# authorized redirect URI = GOOGLE_REDIRECT_URI below. Leave blank to use
# POST /api/v1/auth/dev-login instead (only works while ENV != production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/v1/auth/google/callback
ALLOWED_EMAIL_DOMAIN=newtuple.com

FRONTEND_URL=http://localhost
CORS_ORIGINS=["http://localhost","http://localhost:5180","http://localhost:8010"]

# Flowtuple is a separate, already-deployed workflow system. Point this at it
# and flip FLOWTUPLE_ENABLED=true once its embed URL/params are finalized —
# see app/workflows/flowtuple.py. Onboarding falls back to native checklists
# until then.
FLOWTUPLE_BASE_URL=https://flowtuple.newtuple.internal
FLOWTUPLE_ENABLED=false

# Onboarding notification emails. Leave EMAIL_ENABLED=false to log emails to
# the backend console instead of sending (good for local dev). For Google
# Workspace, use smtp.gmail.com with an app password.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Newtuple HRMS <no-reply@newtuple.com>"
